# ERP03 Environment Configuration
# Copy this file to .env and customize for your environment

# Database Configuration
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_secure_password_change_me
POSTGRES_DB=erp_core
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=erp
RABBITMQ_DEFAULT_PASS=erp_secure_password_change_me
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Application Settings
APP_ENV=production
SECRET_KEY=change_this_to_a_secure_random_string
DEBUG=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration
FRONTEND_ADMIN_PORT=3000
FRONTEND_CLIENT_PORT=3001

# AI Platform Configuration
AI_PLATFORM_PORT=8001

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
