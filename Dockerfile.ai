# ERP03 AI Platform Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements-ai.txt .
RUN pip install --no-cache-dir -r requirements-ai.txt || echo "No requirements-ai.txt found"

# Copy AI platform code
COPY apps/ ./apps/
COPY ai_platform/ ./ai_platform/ 2>/dev/null || true

# Expose AI platform port
EXPOSE 8001

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/healthz')" || exit 1

# Default command - run the AI platform
CMD ["python", "-m", "uvicorn", "ai_platform.main:app", "--host", "0.0.0.0", "--port", "8001"]
